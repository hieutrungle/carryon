figures/*
!figures/.gitkeep
report/build/
logs/*
!logs/slurm/
logs/slurm/*
!logs/slurm/.gitkeep

# Heavy artifacts: never in git (see docs/sync.md)
checkpoints/
*.safetensors
*.bin
*.pt
*.gguf
*.sif
indexes/
hf_cache/
wandb/
.env

# Editors / OS
.vscode/
.idea/
.DS_Store
