# Apptainer image shared by FASTER (A100/A40) and the local RTX 5070 Ti.
# UNTESTED until M0.9. Build: apptainer build carryon.sif container/carryon.def  (from the repo root)
# CUDA 13.0 to match the pinned torch/vLLM wheels (decision 002); FlashInfer JIT-compiles with
# the image's nvcc, so the toolkit must match. Needs driver >= 580: FASTER A40/A100 run
# 580.126.20, the local 5070 Ti runs 595.99.02.
Bootstrap: docker
From: nvidia/cuda:13.0.3-cudnn-devel-ubuntu22.04

%files
    pyproject.toml /opt/carryon/pyproject.toml
    uv.lock /opt/carryon/uv.lock
    README.md /opt/carryon/README.md
    .python-version /opt/carryon/.python-version

%environment
    export PATH=/opt/venv/bin:$PATH
    export UV_PROJECT_ENVIRONMENT=/opt/venv

%post
    apt-get update && apt-get install -y --no-install-recommends git curl ca-certificates \
        && rm -rf /var/lib/apt/lists/*
    curl -LsSf https://astral.sh/uv/install.sh | env UV_INSTALL_DIR=/usr/local/bin sh
    cd /opt/carryon
    # The package itself is bind-mounted from the repo at run time (PYTHONPATH), so only deps go in.
    # --no-cache keeps uv's download cache (several GB of wheels) out of the image.
    UV_PROJECT_ENVIRONMENT=/opt/venv UV_PYTHON_INSTALL_DIR=/opt/python UV_LINK_MODE=copy \
        uv sync --frozen --extra train --no-install-project --no-dev --no-cache

%test
    # Build-time test runs without a GPU; unsloth refuses to import without one, so M0.9 checks
    # it with `apptainer exec --nv carryon.sif python -c "import unsloth"`.
    python -c "import torch, vllm, trl, peft, transformers; print('carryon image ok', torch.__version__, vllm.__version__)"
